global:
  scrape_interval: 15s
  evaluation_interval: 30s

rule_files:
- /etc/prometheus/alert-rules.yml

scrape_configs:
- job_name: node
  static_configs:
  - targets: ['{{ inventory_hostname }}:9100']

alerting:
  alertmanagers:
  - static_configs:
      - targets:
        - {{ inventory_hostname }}:9093
